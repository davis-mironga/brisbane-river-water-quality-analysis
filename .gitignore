# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Jupyter ---
*.ipynb_checkpoints

# --- Data ---
# Raw and processed data are excluded from version control:
#  - the raw Kaggle file must be downloaded manually per README instructions
#  - processed outputs are regenerated by running the notebooks/scripts
# .gitkeep placeholders keep the folder structure tracked in git.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Local databases ---
*.db
*.sqlite
*.sqlite3

# --- Credentials / secrets (never commit these) ---
*.json
!.github/**/*.json
.env
.env.*
service-account*.json
credentials/
gcp-key*.json

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Misc ---
*.log
